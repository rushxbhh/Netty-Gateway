# Database configuration (Defaults to local Docker Postgres if not specified)
# For local Docker:
# G12_DB_URL=jdbc:postgresql://localhost:5432/g12audit
# G12_DB_USER=g12
# G12_DB_PASSWORD=g12_dev_password

# For Cloud PostgreSQL (e.g. Neon, AWS RDS, Supabase):
G12_DB_URL=jdbc:postgresql://<HOST>:5432/<DATABASE>?sslmode=require
G12_DB_USER=<USERNAME>
G12_DB_PASSWORD=<PASSWORD>

# Shared memory ring paths (Defaults to /dev/shm on Linux/Docker, ./ on Windows)
# G12_INBOUND_RING_PATH=./g12-inbound.ring
# G12_JOURNAL_RING_PATH=./g12-journal.ring
# G12_ACK_RING_PATH=./g12-ack.ring
